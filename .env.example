# Copy this file to .env. Never paste the key into chat or commit .env.
OPENAI_API_KEY=

# The model must match book/manifest.json. There is no automatic fallback.
SENTIDO_MODEL=gpt-5.6-sol

# Verify these prices in your OpenAI account before enabling API chat.
# Chat is blocked while either value is blank.
SENTIDO_INPUT_USD_PER_MILLION=
SENTIDO_OUTPUT_USD_PER_MILLION=

SENTIDO_HARD_CAP_USD=10
SENTIDO_MAX_OUTPUT_TOKENS=1600
SENTIDO_PORT=3334
SENTIDO_HOST=127.0.0.1

# Required if SENTIDO_HOST is not 127.0.0.1 or localhost.
SENTIDO_ACCESS_TOKEN=
